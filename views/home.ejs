<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <%- include('./partials/header') %>
  <%- include('./partials/navbar') %>

  <main class="container-fluid px-4 py-4 flex-grow-1">

    <!-- Page Title -->
    <div class="mb-4">
      <h4 class="fw-bold">Dashboard</h4>
      <p class="text-muted mb-0">User Management Overview</p>
      <p class="text-muted small mb-0">Manage users easily using this dashboard.</p>
    </div>

    <!-- Row 1 : Stats -->
    <div class="row g-3 mb-4">

      <!-- Total Users -->
      <div class="col-md-6 d-flex">
        <div class="card shadow-sm border-0 flex-fill">
          <div class="card-body">
            <h6 class="text-muted">Total Users</h6>
            <h3 class="fw-bold"><%= totalUsers || 0 %></h3>
            <small class="text-muted">All registered users</small>
          </div>
        </div>
      </div>

      <!-- Latest User -->
      <div class="col-md-6 d-flex">
        <div class="card shadow-sm border-0 flex-fill">
          <div class="card-body">
            <h6 class="text-muted">Latest User</h6>
            <h5 class="fw-bold">
              <%= latestUser ? latestUser.userName : 'N/A' %>
            </h5>
            <small class="text-muted d-block mb-2">
              <%= latestUser ? latestUser.userEmail : '' %>
            </small>

            <% if(latestUser){ %>
              <a href="/singleView/<%= latestUser._id %>" class="btn btn-success btn-sm">Open</a>
            <% } %>
          </div>
        </div>
      </div>

    </div>

    <!-- Row 2 : Quick Actions -->
    <div class="row g-3">

      <!-- Insert -->
      <div class="col-md-6 d-flex">
        <div class="card shadow-sm border-0 flex-fill text-center">
          <div class="card-body">
            <h5 class="fw-bold">Add New User</h5>
            <p class="text-muted small">Insert new user into system</p>
            <a href="/insert" class="btn btn-primary btn-sm">Add User</a>
          </div>
        </div>
      </div>

      <!-- View -->
      <div class="col-md-6 d-flex">
        <div class="card shadow-sm border-0 flex-fill text-center">
          <div class="card-body">
            <h5 class="fw-bold">View Users</h5>
            <p class="text-muted small">See, update or delete users</p>
            <a href="/view" class="btn btn-secondary btn-sm">View Records</a>
          </div>
        </div>
      </div>

    </div>

  </main>

  <%- include('./partials/footer') %>

  </div>
</div>

</body>
</html>
