<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Records</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <!-- Small Header -->
  <%- include('./partials/header') %>

  <!-- Sidebar -->
  <%- include('./partials/navbar') %>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4 flex-grow-1">

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0"><i class="fas fa-list"></i> Records List</h5>
      <a href="/insert" class="btn btn-primary btn-action">
        <i class="fas fa-plus-circle"></i> Add New
      </a>
    </div>

    <div class="card content-card">
      <div class="card-body p-0">

        <table class="table table-bordered table-hover mb-0 align-middle table-custom">
          <thead class="table-light">
            <tr>
              <th width="5%"><i class="fas fa-hashtag"></i></th>
              <th width="10%"><i class="fas fa-image"></i> Photo</th>
              <th><i class="fas fa-user"></i> Name</th>
              <th><i class="fas fa-envelope"></i> Email</th>
              <th><i class="fas fa-phone"></i> Phone</th>
              <th><i class="fas fa-map-marker-alt"></i> Address</th>
              <th width="25%"><i class="fas fa-cog"></i> Actions</th>
            </tr>
          </thead>

          <tbody>
            <% records.forEach((item, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <% if (item.userPhoto) { %>
                    <img src="/uploads/<%= item.userPhoto %>" alt="Profile" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;">
                  <% } else { %>
                    <div style="width: 50px; height: 50px; border-radius: 50%; background-color: #ddd; display: flex; align-items: center; justify-content: center;">
                      <i class="fas fa-user-circle" style="font-size: 1.5rem; color: #999;"></i>
                    </div>
                  <% } %>
                </td>
                <td><%= item.userName %></td>
                <td><%= item.userEmail %></td>
                <td><%= item.userPhone %></td>
                <td><%= item.userAddress %></td>
                <td>
                  <a href="/singleView/<%= item._id %>" class="btn btn-info btn-action">
                    <i class="fas fa-eye"></i> View
                  </a>
                  <a href="/update/<%= item._id %>" class="btn btn-success btn-action">
                    <i class="fas fa-edit"></i> Edit
                  </a>
                  <a href="/delete/<%= item._id %>"
                    class="btn btn-danger btn-action"
                    onclick="return confirm('Are you sure you want to delete this record?')">
                    <i class="fas fa-trash"></i> Delete
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

      </div>
    </div>

  </main>

  <!-- Footer -->
  <%- include('./partials/footer') %>

  </div> <!-- closes flex-grow-1 -->
</div> <!-- closes d-flex -->

</body>
</html>
