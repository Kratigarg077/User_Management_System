<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Records</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <!-- Small Header -->
  <%- include('./partials/header') %>

  <!-- Sidebar -->
  <%- include('./partials/navbar') %>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4 flex-grow-1">

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0">Records List</h5>
      <a href="/insert" class="btn btn-primary btn-sm">+ Add New</a>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-0">

        <table class="table table-bordered table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th width="5%">#</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Address</th>
              <th width="25%">Actions</th>
            </tr>
          </thead>

          <tbody>
            <% records.forEach((item, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= item.userName %></td>
                <td><%= item.userEmail %></td>
                <td><%= item.userPhone %></td>
                <td><%= item.userAddress %></td>
                <td>
                  <a href="/singleView/<%= item._id %>" class="btn btn-info btn-sm">View</a>
                  <a href="/update/<%= item._id %>" class="btn btn-success btn-sm">Edit</a>
                  <!-- Delete using get  -->
                  <a href="/delete/<%= item.id %>"
                    class="btn btn-danger btn-sm"
                    onclick="return confirm('Are you sure you want to delete this record?')">
                    Delete
                  </a>
                   <!-- Delete using post  -->
                  <!-- <form action="/delete" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="<%= item._id %>">
                    <button class="btn btn-sm btn-danger"
                      onclick="return confirm('Are you sure you want to delete this record?')">
                      Delete
                    </button>
                  </form> -->
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

      </div>
    </div>

  </main>

  <!-- Footer -->
  <%- include('./partials/footer') %>

  </div> <!-- closes flex-grow-1 -->
</div> <!-- closes d-flex -->

</body>
</html>
