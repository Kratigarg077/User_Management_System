<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signup</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="auth-background">

  <div class="signup-container">
    <div class="card auth-card">
      <div class="card-header">
        <h3><i class="fas fa-user-plus"></i> Signup</h3>
        <small>Create your account</small>
      </div>

      <div class="card-body">

         <%
            errorMsg = typeof errorMsg !== 'undefined' ? errorMsg : null;
            successMsg = typeof successMsg !== 'undefined' ? successMsg : null;
            formData = typeof formData !== 'undefined' ? formData : {};
        %>

        <!-- Messages -->
        <% if (errorMsg) { %>
        <div class="alert alert-danger auth-alert">
            <i class="fas fa-exclamation-circle me-1"></i> <%= errorMsg %>
        </div>
        <% } %>

       <% if (successMsg) { %>
        <div class="alert alert-success auth-alert">
            <i class="fas fa-check-circle me-1"></i> <%= successMsg %>
        </div>
        <% } %>

        <!-- Signup Form -->
        <form method="post" action="/signup" id="signupForm">

          <!-- Full Name Field -->
          <div class="mb-3">
            <label class="form-label auth-form-label">
              <i class="fas fa-user"></i>Full Name
            </label>
            <input 
              type="text" 
              class="form-control auth-form-control" 
              name="userName" 
              placeholder="Enter your full name" 
              value="<%= formData?.userName || '' %>"
              required
              minlength="3"
            >
            <small class="text-muted">Must be at least 3 characters</small>
          </div>

          <!-- Email Field -->
          <div class="mb-3">
            <label class="form-label auth-form-label">
              <i class="fas fa-envelope"></i>Email Address
            </label>
            <input 
              type="email" 
              class="form-control auth-form-control" 
              name="userEmail" 
              placeholder="Enter your email" 
              value="<%= formData?.userEmail || '' %>"
              required
              autocomplete="off"
            >
            <small class="text-muted">We'll never share your email with others.</small>
          </div>

          <!-- Password Field -->
          <div class="mb-3">
            <label class="form-label auth-form-label">
              <i class="fas fa-lock"></i>Password
            </label>
            <input 
              type="password" 
              class="form-control auth-form-control" 
              name="userPassword" 
              placeholder="Create a strong password" 
              required
              minlength="6"
              id="password"
            >
            <small class="text-muted">Must be at least 6 characters</small>
          </div>

          <!-- Confirm Password Field -->
          <div class="mb-3">
            <label class="form-label auth-form-label">
              <i class="fas fa-check-circle"></i>Confirm Password
            </label>
            <input 
              type="password" 
              class="form-control auth-form-control" 
              name="confirmPassword" 
              placeholder="Confirm your password" 
              required
              id="confirmPassword"
            >
          </div>

          <!-- Terms and Conditions -->
          <div class="form-check mb-3">
            <input 
              class="form-check-input" 
              type="checkbox" 
              id="terms"
              required
            >
            <label class="form-check-label small" for="terms">
              I agree to the <a href="#" class="auth-link">Terms and Conditions</a>
            </label>
          </div>

          <!-- Signup Button -->
          <button type="submit" class="btn btn-auth mb-3">
            <i class="fas fa-user-plus"></i> Create Account
          </button>

        </form>

        <!-- Login Link -->
        <div class="login-link">
          <small>Already have an account? 
            <a href="/" class="auth-link">Login</a>
          </small>
        </div>

      </div>
    </div>
  </div>

  <script>
    // Validate password confirmation
    document.getElementById('signupForm').addEventListener('submit', function(e) {
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (password !== confirmPassword) {
        e.preventDefault();
        alert('Passwords do not match!');
        document.getElementById('confirmPassword').focus();
      }
    });

    // Real-time password match check
    document.getElementById('confirmPassword').addEventListener('input', function() {
      const password = document.getElementById('password').value;
      const confirmPassword = this.value;

      if (password && confirmPassword) {
        if (password === confirmPassword) {
          this.classList.remove('is-invalid');
          this.classList.add('is-valid');
        } else {
          this.classList.remove('is-valid');
          this.classList.add('is-invalid');
        }
      }
    });
  </script>

</body>
</html>
