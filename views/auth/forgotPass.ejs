<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="auth-background">

  <div class="forgot-container">
    <div class="card auth-card">
      <div class="card-header">
        <h3><i class="fas fa-key"></i> Reset Password</h3>
        <small>Recover your account</small>
      </div>

      <div class="card-body">

        <!-- Info Message -->
        <div class="info-text">
          <i class="fas fa-info-circle"></i>
          Enter your email address and we'll send you instructions to reset your password.
        </div>

        <!-- Reset Form -->
        <form method="post" action="/forgot-password">

          <!-- Email Field -->
          <div class="mb-3">
            <label class="form-label auth-form-label">
              <i class="fas fa-envelope"></i>Email Address
            </label>
            <input 
              type="email" 
              class="form-control auth-form-control" 
              name="userEmail" 
              placeholder="Enter your registered email" 
              required
              autocomplete="off"
            >
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-auth mb-3">
            <i class="fas fa-paper-plane"></i> Send Reset Link
          </button>

        </form>

        <!-- Back to Login Link -->
        <div class="back-login">
          <small>Remember your password? 
            <a href="/" class="auth-link">Back to login</a>
          </small>
        </div>

      </div>
    </div>
  </div>

</body>
</html>
