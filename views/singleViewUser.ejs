<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Record</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <!-- Small Header -->
  <%- include('./partials/header') %>

  <!-- Sidebar -->
  <%- include('./partials/navbar') %>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4 flex-grow-1">

    <div class="mb-3">
      <a href="/view" class="btn btn-secondary btn-sm">← Back to List</a>
    </div>

    <% if (record) { %>
      <div class="card shadow-sm">
        <div class="card-header bg-light fw-bold">
          Record Details
        </div>

        <div class="card-body">
          <table class="table table-bordered mb-0">
            <tr>
              <th width="30%">Name</th>
              <td><%= record.userName %></td>
            </tr>
            <tr>
              <th>Email</th>
              <td><%= record.userEmail %></td>
            </tr>
            <tr>
              <th>Phone</th>
              <td><%= record.userPhone %></td>
            </tr>
            <tr>
              <th>Address</th>
              <td><%= record.userAddress %></td>
            </tr>
          </table>
        </div>

        <div class="card-footer d-flex gap-2">
          <a href="/update/<%= record._id %>" class="btn btn-success btn-sm">Edit</a>
           <form action="/delete" method="post" style="display:inline;">
              <input type="hidden" name="id" value="<%= record._id %>">
              <button class="btn btn-sm btn-danger"
                onclick="return confirm('Are you sure you want to delete this record?')">
                Delete
              </button>
            </form>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-warning">
        Record not found.
      </div>
    <% } %>

  </main>

  <!-- Footer -->
  <%- include('./partials/footer') %>

  </div> <!-- closes flex-grow-1 -->
</div> <!-- closes d-flex -->

</body>
</html>
