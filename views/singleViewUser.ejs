<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Record</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <!-- Small Header -->
  <%- include('./partials/header') %>

  <!-- Sidebar -->
  <%- include('./partials/navbar') %>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4 flex-grow-1">

    <div class="mb-3">
      <a href="/view" class="btn btn-secondary btn-action">
        <i class="fas fa-arrow-left"></i> Back to List
      </a>
    </div>

    <% if (record) { %>
      <div class="card content-card">
        <div class="card-header">
          <i class="fas fa-user-circle"></i> Record Details
        </div>

        <div class="card-body">
          <!-- Profile Photo Section -->
          <div class="mb-4 text-center">
            <% if (record.userPhoto) { %>
              <img src="/uploads/<%= record.userPhoto %>" alt="Profile Photo" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #39A6A3;">
            <% } else { %>
              <div style="width: 150px; height: 150px; border-radius: 50%; background-color: #ddd; display: flex; align-items: center; justify-content: center; margin: 0 auto; border: 3px solid #39A6A3;">
                <i class="fas fa-user-circle" style="font-size: 4rem; color: #999;"></i>
              </div>
            <% } %>
          </div>

          <table class="table table-bordered mb-0">
            <tr>
              <th width="30%"><i class="fas fa-user"></i> Name</th>
              <td><%= record.userName %></td>
            </tr>
            <tr>
              <th><i class="fas fa-envelope"></i> Email</th>
              <td><%= record.userEmail %></td>
            </tr>
            <tr>
              <th><i class="fas fa-phone"></i> Phone</th>
              <td><%= record.userPhone %></td>
            </tr>
            <tr>
              <th><i class="fas fa-map-marker-alt"></i> Address</th>
              <td><%= record.userAddress %></td>
            </tr>
          </table>
        </div>

        <div class="card-footer d-flex gap-2">
          <a href="/update/<%= record._id %>" class="btn btn-success btn-action">
            <i class="fas fa-edit"></i> Edit
          </a>
          <a href="/delete/<%= record._id %>" 
            class="btn btn-danger btn-action"
            onclick="return confirm('Are you sure you want to delete this record?')">
            <i class="fas fa-trash"></i> Delete
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-warning">
        Record not found.
      </div>
    <% } %>

  </main>

  <!-- Footer -->
  <%- include('./partials/footer') %>

  </div> <!-- closes flex-grow-1 -->
</div> <!-- closes d-flex -->

</body>
</html>
