<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Footer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
</head>
<body>
  <footer class="border-top mt-auto" style="background-color: whitesmoke;">
    <div class="container-fluid px-4">

      <!-- Top -->
      <div class="row py-3 small">

        <!-- Quick Links -->
        <div class="col-md-4 mb-2 mb-md-0">
          <strong class="d-block mb-1">Quick Links</strong>
          <a href="/home" class="d-block text-muted text-decoration-none">Home</a>
          <a href="/insert" class="d-block text-muted text-decoration-none">Insert</a>
          <a href="/view" class="d-block text-muted text-decoration-none">List</a>
        </div>

        <!-- Contact -->
        <div class="col-md-4 mb-2 mb-md-0">
          <strong class="d-block mb-1">Contact</strong>
          <span class="d-block text-muted">support@crudapp.com</span>
          <span class="d-block text-muted">+91 98765 43210</span>
        </div>

      </div>

      <!-- Bottom -->
      <div class="border-top py-2 text-center small text-muted">
        © <%= new Date().getFullYear() %> CRUD App
      </div>

    </div>
  </footer>

</body>
</html>