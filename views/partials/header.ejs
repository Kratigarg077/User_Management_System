<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<header class="border-bottom" style="background-color: whitesmoke;">
  <div class="container-fluid px-4 py-2 d-flex align-items-center justify-content-between">
    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
      <span class="fw-bold text-dark"><i class="fas fa-cogs me-2"></i>CRUD App</span>
    </a>
    
    <!-- User Menu on Top Right -->
    <% if(user) { %>
      <div class="d-flex align-items-center gap-3">
        <span class="text-dark small">
          <i class="fas fa-user-circle me-1"></i>Welcome, <strong><%= user.userName %></strong>
        </span>
        <a href="/logout" class="btn btn-outline-danger btn-sm">
          <i class="fas fa-sign-out-alt me-1"></i> Logout
        </a>
      </div>
    <% } %>
  </div>
</header>