<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Update</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <!-- Small Header -->
  <%- include('./partials/header') %>

  <!-- Sidebar -->
  <%- include('./partials/navbar') %>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-lg-6">

        <% if (typeof errorMsg !== 'undefined') { %>
          <div class="alert alert-danger">
              <i class="fas fa-exclamation-circle"></i> <%= errorMsg %>
          </div>
        <% } %>

        <% if (record) { %>
          <div class="card content-card">
            <div class="card-header">
              <i class="fas fa-edit"></i> Update Record
            </div>

            <div class="card-body">
              <form method="post" action="/update/<%= record._id %>" enctype="multipart/form-data">

                <!-- Hidden ID -->
                <input type="hidden" name="id" value="<%= record._id %>">

                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-user"></i> Name
                  </label>
                  <input
                    type="text"
                    name="userName"
                    class="form-control"
                    value="<%= record.userName %>"
                    required
                  >
                </div>

                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-envelope"></i> Email
                  </label>
                  <input
                    type="email"
                    name="userEmail"
                    class="form-control"
                    value="<%= record.userEmail %>"
                    required
                  >
                </div>

                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-phone"></i> Phone
                  </label>
                  <input
                    type="text"
                    name="userPhone"
                    class="form-control"
                    value="<%= record.userPhone %>"
                    required
                  >
                </div>

                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-map-marker-alt"></i> Address
                  </label>
                  <textarea
                    name="userAddress"
                    class="form-control"
                    rows="3"
                    required
                  ><%= record.userAddress %></textarea>
                </div>

                <!-- Profile Photo Upload -->
                <div class="mb-3">
                  <% if (record.userPhoto) { %>
                    <div class="mb-2">
                      <p class="form-label mb-2">
                        <i class="fas fa-image"></i> Current Photo
                      </p>
                      <img src="/uploads/<%= record.userPhoto %>" alt="Profile Photo" style="max-width: 150px; height: auto; border-radius: 5px;">
                    </div>
                  <% } %>
                  <label class="form-label">
                    <i class="fas fa-camera"></i> Profile Photo
                  </label>
                  <input type="file" class="form-control" name="userPhoto" accept="image/*">
                  <small class="text-muted">Max size: 5MB. Accepted formats: JPG, PNG, GIF</small>
                </div>

                <button type="submit" class="btn btn-success btn-action">
                  <i class="fas fa-check"></i> Update
                </button>
                <a href="/view" class="btn btn-secondary btn-action">
                  <i class="fas fa-times"></i> Cancel
                </a>

              </form>

            </div>
          </div>
        <% } else { %>
          <div class="alert alert-warning">
            Record not found.
          </div>
        <% } %>

      </div>
    </div>
  </main>

  <!-- Footer -->
  <%- include('./partials/footer') %>

  </div> <!-- closes flex-grow-1 -->
</div> <!-- closes d-flex -->

</body>
</html>
