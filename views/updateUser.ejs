<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Update</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <!-- Small Header -->
  <%- include('./partials/header') %>

  <!-- Sidebar -->
  <%- include('./partials/navbar') %>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-lg-6">

        <% if (record) { %>
          <div class="card shadow-sm">
            <div class="card-header bg-light fw-bold">
              Update Record
            </div>

            <div class="card-body">
              <form method="post" action="/update/<%= record._id %>">

                <!-- Hidden ID -->
                <input type="hidden" name="id" value="<%= record._id %>">

                <div class="mb-3">
                  <label class="form-label">Name</label>
                  <input
                    type="text"
                    name="userName"
                    class="form-control"
                    value="<%= record.userName %>"
                    required
                  >
                </div>

                <div class="mb-3">
                  <label class="form-label">Email</label>
                  <input
                    type="email"
                    name="userEmail"
                    class="form-control"
                    value="<%= record.userEmail %>"
                    required
                  >
                </div>

                <div class="mb-3">
                  <label class="form-label">Phone</label>
                  <input
                    type="text"
                    name="userPhone"
                    class="form-control"
                    value="<%= record.userPhone %>"
                    required
                  >
                </div>

                <div class="mb-3">
                  <label class="form-label">Address</label>
                  <textarea
                    name="userAddress"
                    class="form-control"
                    rows="3"
                    required
                  ><%= record.userAddress %></textarea>
                </div>

                <button type="submit" class="btn btn-success btn-sm">
                  Update
                </button>
                <a href="/view" class="btn btn-secondary btn-sm">
                  Cancel
                </a>

              </form>

            </div>
          </div>
        <% } else { %>
          <div class="alert alert-warning">
            Record not found.
          </div>
        <% } %>

      </div>
    </div>
  </main>

  <!-- Footer -->
  <%- include('./partials/footer') %>

  </div> <!-- closes flex-grow-1 -->
</div> <!-- closes d-flex -->

</body>
</html>
