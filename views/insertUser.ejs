<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Insert</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="min-vh-100 d-flex flex-column">

  <!-- Small Header -->
  <%- include('./partials/header') %>

  <!-- Sidebar -->
  <%- include('./partials/navbar') %>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-lg-6">

        <% if (typeof errorMsg !== 'undefined') { %>
          <div class="alert alert-danger">
              <i class="fas fa-exclamation-circle"></i> <%= errorMsg %>
          </div>
        <% } %>

        <div class="card content-card">
          <div class="card-header">
            <i class="fas fa-plus-circle"></i> Insert Record
          </div>

          <div class="card-body">
            <form method="post" action="/insert" enctype="multipart/form-data">

              <div class="mb-3">
                <label class="form-label">
                  <i class="fas fa-user"></i> Name
                </label>
                <input type="text" class="form-control" name="userName" placeholder="Enter name" required>
              </div>

              <div class="mb-3">
                <label class="form-label">
                  <i class="fas fa-envelope"></i> Email
                </label>
                <input type="email" class="form-control" name="userEmail" placeholder="Enter email" required>
              </div>

              <div class="mb-3">
                <label class="form-label">
                  <i class="fas fa-phone"></i> Phone
                </label>
                <input type="tel" class="form-control" name="userPhone" placeholder="Enter phone" required>
              </div>

              <div class="mb-3">
                <label class="form-label">
                  <i class="fas fa-map-marker-alt"></i> Address
                </label>
                <textarea class="form-control" name="userAddress" rows="3" required></textarea>
              </div>

              <!-- Profile Photo Upload -->
              <div class="mb-3">
                <label class="form-label">
                  <i class="fas fa-image"></i> Profile Photo
                </label>
                <input type="file" class="form-control" name="userPhoto" accept="image/*">
                <small class="text-muted">Max size: 5MB. Accepted formats: JPG, PNG, GIF</small>
              </div>

              <button class="btn btn-primary btn-action">
                <i class="fas fa-save"></i> Save
              </button>
              <a href="/view" class="btn btn-secondary btn-action">
                <i class="fas fa-times"></i> Cancel
              </a>

            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Footer -->
  <%- include('./partials/footer') %>

  </div> <!-- closes flex-grow-1 -->
</div> <!-- closes d-flex -->

</body>
</html>
